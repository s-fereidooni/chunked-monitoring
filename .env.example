# Copy to .env and fill in. Never commit .env.

# Anthropic API key for the monitor LLM.
# Alternative: run `ant auth login` and leave this unset — the SDK picks up the
# stored profile automatically.
ANTHROPIC_API_KEY=

# Hugging Face token. MALT is a gated dataset: you must (1) accept the terms at
# https://huggingface.co/datasets/metr-evals/malt-public and (2) supply a token.
HF_TOKEN=
