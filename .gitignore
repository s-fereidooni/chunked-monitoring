# Environment
.env

# Data — large, gated, and reproducible from the evaluation subset IDs.
# data/evaluation_subset.json is NOT ignored: it defines reproducibility.
# These directories are created at runtime by paths.ensure_dir().
data/raw/
data/processed/

# Transcript dumps from `show_run.py` and friends. MALT is gated: METR controls
# who receives the transcripts, so verbatim run text must never be committed,
# whatever it happens to be named locally.
prompted.txt
*_transcript.txt
*_transcripts.txt
transcripts/

# Experiment outputs
results/

# LLM response cache
.cache/

